---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { BreakpointIndicator, fontInitScript, themeInitScript } from 'shelter-assets';
import latinFont from 'shelter-assets/fonts/playpen-sans/latin.woff2?url';
import { pathWithoutLocale, useTranslations } from '../lib/i18n';
import { defaultLocale, locales } from '../lib/locales';
import Footer from '../components/sections/Footer.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname);
const t = useTranslations(Astro.currentLocale);
const canonical = getAbsoluteLocaleUrl(Astro.currentLocale ?? defaultLocale, path);
// la misma imagen para todas las paginas e idiomas: solo lleva machka y "shelter"
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<!-- SIEMPRE CARGAR SCRIPT DE TEMA PRIMERO -->
		<script is:inline set:html={themeInitScript} />
		<!-- elegir fuente -> shelter-assets font-loading.ts -->
		<script is:inline set:html={fontInitScript} />
		<!-- descargar -->
		<link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width" />

		<!-- iconos -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<>
				<!-- decir a gugul que hay mas idiomas -->
				<link rel="canonical" href={canonical} />
				{locales.map((locale) => (
					<link rel="alternate" hreflang={locale} href={getAbsoluteLocaleUrl(locale, path)} />
				))}
				<link
					rel="alternate"
					hreflang="x-default"
					href={getAbsoluteLocaleUrl(defaultLocale, path)}
				/>
			</>
		)}

		<!-- tarjeta al compartir el link (discord, whatsapp, x...) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="shelter" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('landing.hero.image_alt')} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
		<!-- solo en dev: breakpoint actual de tailwind -->
		{import.meta.env.DEV && <BreakpointIndicator />}
		<script>
			import { watchThemePreference } from 'shelter-assets';

			// seguir el tema si cambia en otra pestaña o en el sistema (con 'system')
			watchThemePreference();
		</script>
	</body>
</html>
