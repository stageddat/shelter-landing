---
// privacy, terms, cookies: same layout, only the sections change
import Layout from './Layout.astro';

type Props = {
	metaTitle: string;
	description: string;
	title: string;
	lastUpdated: string;
};

const { metaTitle, description, title, lastUpdated } = Astro.props;
---

<Layout title={metaTitle} description={description}>
	<main class="mx-auto max-w-4xl px-8 py-20 lg:py-24">
		<h1 class="mb-2 font-bold text-foreground">{title}</h1>
		<p class="mb-12 text-balance text-muted-foreground">{lastUpdated}</p>

		<div class="space-y-12">
			<slot />
		</div>
	</main>
</Layout>
