---
// Fills shelter-assets' LanguageSelector with this site's languages and links.
// Rendered to HTML at build time: no JavaScript reaches the browser.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LanguageSelector, type LanguageOption } from 'shelter-assets';
import { pathWithoutLocale } from '../lib/i18n';
import { localeName, locales, officialLocales, type Locale } from '../lib/locales';

type Props = { class?: string };

const current = (Astro.currentLocale ?? 'en') as Locale;
const path = pathWithoutLocale(Astro.url.pathname);

const languages: LanguageOption[] = locales.map((locale) => ({
	locale,
	label: localeName(locale),
	href: getRelativeLocaleUrl(locale, path),
	official: officialLocales.includes(locale)
}));
---

<LanguageSelector {current} {languages} class={Astro.props.class} />
