---
import { useTranslations } from '../../lib/i18n';
import lockedJournal from '../../assets/locked-journal.svg?url';

const t = useTranslations(Astro.currentLocale);

const items = [
	{ title: t('landing.security.1.title'), text: t('landing.security.1.description') },
	{ title: t('landing.security.2.title'), text: t('landing.security.2.description') },
	{ title: t('landing.security.3.title'), text: t('landing.security.3.description') }
];
---

<section id="security" class="bg-background px-4 py-24 md:px-8 lg:py-40">
	<div class="mx-auto max-w-6xl">
		<h2 class="mb-4 text-center text-pretty text-foreground lg:mb-7">
			{t('landing.security.title')}
		</h2>

		<div class="flex flex-col items-center gap-2 lg:flex-row lg:gap-24">
			<div class="relative flex w-full justify-center lg:w-1/2">
				<!-- lazy: el href lo pone el script de abajo cuando se acerca a la pantalla -->
				<svg
					class="illustration aspect-square w-full max-w-sm sm:max-w-md"
					viewBox="0 0 1400 1400"
					role="img"
					aria-label={t('landing.security.image_alt')}
				>
					<use data-lazy-href={`${lockedJournal}#locked-journal`} />
				</svg>
			</div>

			<div class="w-full space-y-6 lg:w-1/2">
				{items.map((item) => (
					<article class="group space-y-3">
						<h3 class="font-normal text-foreground">{item.title}</h3>
						<div class="relative border-l-2 border-border/60 pl-6 transition-colors group-hover:border-primary">
							<p class="leading-relaxed text-pretty text-muted-foreground">{item.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	// <use> no tiene loading="lazy": se descarga el svg solo cuando el dibujo esta cerca de verse
	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const use = entry.target.querySelector('use[data-lazy-href]');
				if (use) use.setAttribute('href', use.getAttribute('data-lazy-href') ?? '');
				io.unobserve(entry.target);
			}
		},
		{ rootMargin: '300px' }
	);
	document.querySelectorAll('svg:has(use[data-lazy-href])').forEach((svg) => io.observe(svg));
</script>
