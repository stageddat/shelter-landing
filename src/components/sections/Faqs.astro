---
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from 'shelter-assets';
import { safeHtml } from '../../lib/html';
import { useTranslations } from '../../lib/i18n';

const t = useTranslations(Astro.currentLocale);

const faqs = ([1, 2, 3, 4, 5, 6] as const).map((n) => ({
	question: t(`landing.faqs.${n}.question`),
	answer: safeHtml(t(`landing.faqs.${n}.answer`))
}));
---

<section id="faqs" class="bg-background px-8 py-24 lg:py-40">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-16 text-center font-normal text-pretty text-foreground">
			{t('landing.faqs.title')}
		</h2>

		<Accordion class="space-y-3">
			{faqs.map((faq) => (
				<AccordionItem
					name="faqs"
					class="rounded-2xl border border-border bg-secondary/20 px-6 py-1 transition-colors hover:bg-secondary/30"
				>
					<AccordionTrigger class="items-center font-semibold **:data-[slot=accordion-trigger-icon]:size-6 tracking-wide text-foreground hover:text-primary hover:no-underline">
						{faq.question}
					</AccordionTrigger>
					<AccordionContent class="leading-relaxed text-muted-foreground">
						<Fragment set:html={faq.answer} />
					</AccordionContent>
				</AccordionItem>
			))}
		</Accordion>
	</div>
</section>
