---
import { Button } from 'shelter-assets';
import { useTranslations } from '../../lib/i18n';
import { signupUrl } from '../../lib/links';

const t = useTranslations(Astro.currentLocale);
---

<section id="start" class="relative overflow-hidden bg-background px-8 py-32 lg:py-52">
	<div class="mx-auto max-w-4xl text-center">
		<div class="space-y-6">
			<h2 class="font-normal text-foreground">{t('landing.start.title')}</h2>
			<p class="mx-auto max-w-md leading-relaxed text-muted-foreground">
				{t('landing.start.description')}
			</p>
		</div>

		<div class="mt-2 flex flex-col items-center gap-6">
			<Button href={signupUrl} size="lg" class="font-semibold">
				{t('landing.start.button')}
			</Button>
		</div>
	</div>
</section>
