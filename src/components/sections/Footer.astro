---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../lib/i18n';
import { discordUrl, githubUrl } from '../../lib/links';
import { defaultLocale } from '../../lib/locales';
import FooterLink from '../FooterLink.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(locale);
const url = (path: string) => getRelativeLocaleUrl(locale, path);

// año actual al hacer build
// dejarlo tal cual pq creo pq aun lo mantendre un tiempo
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border/40 bg-background pt-16 pb-12">
	<div class="mx-auto w-11/12 max-w-7xl">
		<div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
			<div class="space-y-4">
				<p class="font-normal tracking-wide text-foreground">{t('landing.footer.title')}</p>
				<div class="space-y-1 leading-relaxed text-muted-foreground">
					<p>{t('landing.footer.year', { currentYear })}</p>
					<p>{t('landing.footer.copyright')}</p>
				</div>
			</div>

			<div class="space-y-4">
				<p class="font-medium tracking-wide text-foreground">{t('landing.footer.product.title')}</p>
				<nav class="flex flex-col space-y-2.5">
					<FooterLink href={url('/credits')}>{t('landing.footer.product.credits')}</FooterLink>
					<FooterLink href={url('/')}>{t('landing.footer.product.cloud')}</FooterLink>
					<FooterLink href={url('/')}>{t('landing.footer.product.selfhost')}</FooterLink>
				</nav>
			</div>

			<div class="space-y-4">
				<p class="font-medium tracking-wide text-foreground">{t('landing.footer.legal.title')}</p>
				<nav class="flex flex-col space-y-2.5">
					<FooterLink href={url('/privacy')}>{t('landing.footer.legal.privacy')}</FooterLink>
					<FooterLink href={url('/terms')}>{t('landing.footer.legal.terms')}</FooterLink>
					<FooterLink href={url('/cookies')}>{t('landing.footer.legal.cookies')}</FooterLink>
				</nav>
			</div>

			<div class="space-y-4">
				<p class="font-medium tracking-wide text-foreground">{t('landing.footer.contact.title')}</p>
				<nav class="flex flex-col space-y-2.5">
					<FooterLink href={githubUrl} external>
						github
					</FooterLink>
					<FooterLink href={discordUrl} external>
						discord
					</FooterLink>
				</nav>
			</div>
		</div>
	</div>
</footer>
