---
import { Button } from 'shelter-assets';
import { useTranslations } from '../../lib/i18n';
import { signupUrl } from '../../lib/links';
// ?url: esto permite cachear en astro? o eso dice claude xd
import machkaHero from '../../assets/machka-hero.svg?url';

const t = useTranslations(Astro.currentLocale);
---

<!-- 100svh menos el header h-20 -->
<section class="relative flex min-h-[calc(100svh-5rem)] w-full items-center overflow-hidden bg-background px-6 sm:px-8">
	<div class="mx-auto flex w-full max-w-7xl flex-col items-center gap-6 py-6 sm:gap-10 sm:py-12 lg:flex-row lg:gap-0 lg:py-16">
		<div class="flex flex-1 flex-col items-center text-center lg:items-start lg:text-left">
			<h1 class="text-7xl font-light tracking-tight short:max-sm:text-6xl lg:text-8xl">
				{t('landing.hero.title')}
			</h1>
			<p class="mt-3 max-w-xl text-xl leading-relaxed text-pretty text-muted-foreground sm:mt-6">
				{t('landing.hero.subtitle')}
			</p>

			<div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:mt-10 sm:gap-3 lg:justify-start">
				<Button href={signupUrl} size="lg" class="font-semibold">
					{t('landing.hero.cta')}
				</Button>
				<Button href="#features" variant="ghost" size="lg">
					{t('landing.hero.secondary_cta')}
				</Button>
			</div>
		</div>

		<div class="flex w-full flex-1 items-center justify-center lg:-ml-16">
			<div class="relative w-full max-w-[min(20rem,32svh)] sm:max-w-[min(32rem,42svh)] lg:max-w-175">
				<div class="hero-blob absolute inset-[8%] bg-muted" aria-hidden="true"></div>
				<svg
					class="machka-hero illustration relative h-auto w-full"
					viewBox="0 0 1400 1400"
					role="img"
					aria-label={t('landing.hero.image_alt')}
				>
					<use href={`${machkaHero}#hero`} />
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-blob {
		border-radius: 58% 42% 52% 48% / 46% 56% 44% 54%;
	}

	@media (prefers-reduced-motion: no-preference) {
		.machka-hero {
			animation: float 7s ease-in-out infinite;
		}
		.hero-blob {
			animation: morph 14s ease-in-out infinite;
		}
	}

	@keyframes float {
		50% {
			translate: 0 -12px;
		}
	}

	@keyframes morph {
		50% {
			border-radius: 45% 55% 40% 60% / 55% 45% 58% 42%;
		}
	}
</style>
