---
//subtitulos de los secciones legales
import { safeHtml } from '../lib/html';

type Props = { title: string; paragraphs: string[]; items?: string[] };

const { title, paragraphs, items = [] } = Astro.props;
---

<section class="space-y-4">
	<h2 class="border-b-2 border-primary pb-2 font-bold text-balance text-primary">{title}</h2>
	{paragraphs.map((paragraph) => (
		<p class="text-pretty text-muted-foreground [&_a]:link" set:html={safeHtml(paragraph)} />
	))}
	{items.length > 0 && (
		<ul class="ml-6 list-disc space-y-2 text-muted-foreground">
			{items.map((item) => (
				<li>{item}</li>
			))}
		</ul>
	)}
</section>
