---
import type { AstroComponent } from '@lucide/astro';

type Props = {
	icon: AstroComponent;
	title: string;
	text: string;
};

const { icon: Icon, title, text } = Astro.props;
---

<article class="relative flex flex-col rounded-xl bg-secondary/50 p-4 transition-colors duration-300 ease-in-out hover:bg-accent/50 md:p-6 lg:p-8">
	<div class="mb-6 inline-flex size-12 items-center justify-center rounded-lg border border-border/50 bg-background text-primary">
		<Icon class="size-6" stroke-width={1.5} aria-hidden="true" />
	</div>

	<div class="space-y-3">
		<h3 class="text-3xl font-medium text-foreground">{title}</h3>
		<p class="text-2xl leading-relaxed text-pretty text-muted-foreground">{text}</p>
	</div>
</article>
