---
import Faqs from '../../components/sections/Faqs.astro';
import Features from '../../components/sections/Features.astro';
import Hero from '../../components/sections/Hero.astro';
import Security from '../../components/sections/Security.astro';
import Start from '../../components/sections/Start.astro';
import Layout from '../../layouts/Layout.astro';
import { localeStaticPaths, useTranslations } from '../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t('metadata.landing.title')} description={t('metadata.landing.description')}>
	<main>
		<Hero />
		<Features />
		<Security />
		<Faqs />
		<Start />
	</main>
</Layout>
