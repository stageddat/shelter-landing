---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { localeStaticPaths, useTranslations } from '../../lib/i18n';

import _4xlsPfp from '../../assets/credits/4xls.png';
import bestPfp from '../../assets/credits/bestgamez.jpg';
import cheesyPfp from '../../assets/credits/cheesy.png';
import csPfp from '../../assets/credits/cs.jpg';
import defaultPfp from '../../assets/credits/default.webp';
import fiddlePfp from '../../assets/credits/fiddle.jpg';
import joshPfp from '../../assets/credits/josh.jpg';
import kiwiPfp from '../../assets/credits/kiwi.jpg';
import meteorPfp from '../../assets/credits/meteor.jpg';
import pandaPfp from '../../assets/credits/panda.png';
import stageddatPfp from '../../assets/credits/stageddat.jpeg';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale);

const roleNames = {
	development: t('landing.credits.roles.development'),
	artist: t('landing.credits.roles.artist'),
	tester: t('landing.credits.roles.tester'),
	translator: t('landing.credits.roles.translator')
};
type Role = keyof typeof roleNames;

const contributors: {
	name: string;
	pfp: ImageMetadata;
	roles: Role[];
	links: { label: string; href: string }[];
}[] = [
	{
		name: 'stageddat',
		pfp: stageddatPfp,
		roles: ['development'],
		links: [
			{ label: 'web', href: 'https://stageddat.dev' },
			{ label: 'github', href: 'https://github.com/stageddat' }
		]
	},
	{
		name: 'fiddle',
		pfp: fiddlePfp,
		roles: ['artist'],
		links: [{ label: 'instagram', href: 'https://www.instagram.com/fiddlearty/' }]
	},
	{ name: 'josh', pfp: joshPfp, roles: ['tester'], links: [] },
	{ name: 'Cheesy Bacon', pfp: cheesyPfp, roles: ['tester', 'translator'], links: [] },
	{ name: 'BestG', pfp: bestPfp, roles: ['translator'], links: [] },
	{ name: '4XLS', pfp: _4xlsPfp, roles: ['tester'], links: [] },
	{ name: 'meteor', pfp: meteorPfp, roles: ['tester'], links: [] },
	{ name: 'panda', pfp: pandaPfp, roles: ['tester'], links: [] },
	{ name: 'fisch', pfp: defaultPfp, roles: ['translator'], links: [] },
	{ name: 'Capitan Solnan', pfp: csPfp, roles: ['tester'], links: [] },
	{
		name: 'kiwi',
		pfp: kiwiPfp,
		roles: ['tester'],
		links: [{ label: 'youtube', href: 'https://www.youtube.com/@thesubmergedkiwi' }]
	}
];
---

<Layout title={t('metadata.credits.title')} description={t('metadata.credits.description')}>
	<main class="mx-auto max-w-4xl px-4 pt-6 pb-12 sm:px-6">
		<h1 class="mb-6 font-bold text-foreground">{t('landing.credits.title')}</h1>
		<p class="text-pretty text-muted-foreground">{t('landing.credits.intro')}</p>

		<section class="mt-10">
			<h2 class="border-b-2 border-primary pb-2 font-bold text-balance text-primary">
				{t('landing.credits.contributors')}
			</h2>
			<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
				{contributors.map((contributor) => (
					<div class="flex flex-col items-center gap-3 rounded-lg border p-4 text-center">
						<!-- 128px on screen; 2x for sharp screens. Astro makes the AVIF/WebP files at build time -->
						<Picture
							src={contributor.pfp}
							alt={contributor.name}
							width={128}
							height={128}
							densities={[1, 2]}
							formats={['avif', 'webp']}
							loading="lazy"
							class="size-32 shrink-0 rounded-full object-cover"
						/>
						<div>
							<p class="font-medium tracking-wide">{contributor.name}</p>
							<div class="mt-1 flex flex-row flex-wrap items-center justify-center gap-2">
								{contributor.roles.map((role) => (
									<p class="rounded-md border px-1.5 text-muted-foreground">{roleNames[role]}</p>
								))}
							</div>
						</div>
						{contributor.links.length > 0 && (
							<div class="mt-1 flex flex-wrap justify-center gap-3">
								{contributor.links.map((link) => (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-primary underline-offset-4 hover:underline"
									>
										{link.label}
									</a>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</main>
</Layout>
