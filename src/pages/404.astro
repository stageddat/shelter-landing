---
// vercel sirve este 404.html con estado 404 para cualquier url que no exista
// (asi google deja de guardar las paginas viejas del dominio, como /carta-shelter)
import { Button } from 'shelter-assets';
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../lib/i18n';

const t = useTranslations(Astro.currentLocale);
---

<Layout
	title={t('metadata.notFound.title')}
	description={t('metadata.notFound.description')}
	noindex
>
	<main class="mx-auto flex max-w-4xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:py-32">
		<p class="text-7xl font-light text-muted-foreground">404</p>
		<h1 class="mt-4 text-pretty">{t('landing.notFound.title')}</h1>
		<p class="mt-3 text-pretty text-muted-foreground">{t('landing.notFound.description')}</p>
		<Button href="/" size="lg" class="mt-8">
			{t('landing.notFound.home')}
		</Button>
	</main>
</Layout>
